% Ported from ai-job-search (MIT): cv/main_example.tex
% Compile with lualatex.

\documentclass[11pt,a4paper,sans]{moderncv}
\moderncvstyle{banking}
\moderncvcolor{blue}
% Plain-text contact labels and a real bullet glyph keep the PDF text layer clean for ATS.
\moderncvicons{letters}
\renewcommand{\labelitemi}{\textbullet}

% Force the name and section headings to render in moderncv blue (color1).
\renewcommand*{\namefont}{\fontsize{34}{36}\bfseries\upshape}
\colorlet{firstnamecolor}{color1}
\colorlet{lastnamecolor}{color1}
\colorlet{namecolor}{color1}
\renewcommand*{\sectionstyle}[1]{{\sectionfont\color{color1}#1}}

\ifpdftex\usepackage[T1]{fontenc}\fi
% Lato from the bundled OFL fonts (copied into the job dir); moderncv banking uses the sans family.
\usepackage{fontspec}
\setmainfont{Lato-Reg.ttf}[Path=OpenFonts/fonts/lato/, UprightFont=Lato-Reg.ttf, BoldFont=Lato-Bol.ttf,
    ItalicFont=Lato-RegIta.ttf, BoldItalicFont=Lato-BolIta.ttf]
\setsansfont{Lato-Reg.ttf}[Path=OpenFonts/fonts/lato/, UprightFont=Lato-Reg.ttf, BoldFont=Lato-Bol.ttf,
    ItalicFont=Lato-RegIta.ttf, BoldItalicFont=Lato-BolIta.ttf]
% hyperref is loaded by moderncv in \AtEndPreamble, so configure it there too.
\AtEndPreamble{\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    filecolor=magenta,
    urlcolor=blue,
    pdftitle={\VAR{(contact.first ~ " " ~ contact.last) | tex} - CV},
    pdfpagemode=UseNone,
}}
\usepackage[scale=0.80]{geometry}
% Keep every word whole: a hyphenated line break splits a keyword ("Type-" / "ORM")
% in the text layer ATS parsers read. Extra stretch avoids overfull lines.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em

\name{\VAR{contact.first | tex}}{\VAR{contact.last | tex}}
%% if contact.title
\title{\mbox{\VAR{contact.title.split(" | ") | map("tex") | join("} |\\allowbreak{} \\mbox{")}}}
%% endif
%% if contact.address
\address{\VAR{contact.address | tex}}{}{}
%% endif
% Each contact item is its own header element, so moderncv wraps the line between
% items instead of clipping it at the page edge. \extrainfo normally adds one element;
% the patch lets it add several. Plain visible text: no icons or labels in the text layer.
\usepackage{etoolbox}
\makeatletter
\patchcmd{\makehead}{\addtomakeheaddetails{\@extrainfo}}{\@extrainfo}{}%
  {\PackageError{cvforge}{cannot patch moderncv \string\makehead\space for the contact line}{}}
% The name stays on one centred line: 34pt when it fits, otherwise scaled down to the
% header width. The title goes on its own centred line under it (no "|" separator before
% it), smaller than the name; it breaks only after a " | " between its parts, and each
% part is an unbreakable box.
\renewcommand*{\titlefont}{\fontsize{15}{18}\selectfont\mdseries\upshape}% \titlestyle applies \titlefont last
\newsavebox{\cvnamebox}
\newcommand*{\cvfitname}[1]{\sbox{\cvnamebox}{#1}%
  \ifdim\wd\cvnamebox>\linewidth\resizebox{\linewidth}{!}{\usebox{\cvnamebox}}\else\usebox{\cvnamebox}\fi}
\patchcmd{\makehead}{\firstnamestyle{\@firstname\ }\lastnamestyle{\@lastname}}%
  {\cvfitname{\firstnamestyle{\@firstname\ }\lastnamestyle{\@lastname}}}{}%
  {\PackageError{cvforge}{cannot patch moderncv \string\makehead\space for the name}{}}
%% if contact.permit_line is defined and contact.permit_line
% The permit status goes on its own centred line under the title, before the contact items.
\patchcmd{\makehead}{\titlestyle{~|~\@title}}{\\[0.15em]\titlestyle{\@title}\\[0.15em]{\addressfont\color{addresscolor}\VAR{contact.permit_line | tex}}}{}%
%% else
\patchcmd{\makehead}{\titlestyle{~|~\@title}}{\\[0.15em]\titlestyle{\@title}}{}%
%% endif
  {\PackageError{cvforge}{cannot patch moderncv \string\makehead\space for the title line}{}}
% Keep-with-next, like needspace's \Needspace: start a new page before a heading or an
% entry unless #1 of space is left, so neither ends a page apart from what follows it.
% It measures the space left instead of adding a preferred break, which under
% \raggedbottom would end pages early.
\newcommand*{\keepnext}[1]{\par\begingroup\setlength{\dimen@}{#1}%
  \dimen@ii\pagegoal\advance\dimen@ii-\pagetotal
  \ifdim\dimen@>\dimen@ii\ifdim\dimen@ii>\z@\vfil\fi\break\fi\endgroup}
% Entry bullets. Banking's \cventry sets its description in an unbreakable minipage,
% so a long entry jumps to the next page whole and leaves a hole; this list follows
% the entry instead and breaks between items, never before the first one. Same look:
% small type, no outer gap.
\newenvironment{cvbullets}{\small\@beginparpenalty\@M\list{\labelitemi}{\setlength{\topsep}{0pt}%
  \setlength{\partopsep}{0pt}\setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}}}%
  {\endlist\addvspace{.25em}}
\makeatother
\extrainfo{%
%% for link in contact.links
%% if link.href
\addtomakeheaddetails{\href{\VAR{link.href | url}}{\VAR{link.text | tex}}}%
%% else
\addtomakeheaddetails{\VAR{link.text | tex}}%
%% endif
%% endfor
}

\begin{document}

\makecvtitle

%% if summary
\keepnext{8\baselineskip}
\section{\VAR{headings.summary | tex}}
\cvitem{}{\VAR{summary | tex}}
%% endif

%% if experience
\keepnext{8\baselineskip}
\section{\VAR{headings.experience | tex}}
%% for job in experience
\keepnext{5\baselineskip}
\cventry{\VAR{job.dates | tex}}{\VAR{job.title | tex}}{\VAR{job.employer | tex}}{\VAR{job.location | tex}}{}{}
%% if job.bullets
\begin{cvbullets}
%% for bullet in job.bullets
\item \VAR{bullet | tex}
%% endfor
\end{cvbullets}
%% endif
%% endfor
%% endif

%% if skills
\keepnext{8\baselineskip}
\section{\VAR{headings.skills | tex}}
%% for skill in skills
\cvitem{\VAR{skill.name | tex}}{\VAR{skill.keywords | tex}}
%% endfor
%% endif

%% if education
\keepnext{8\baselineskip}
\section{\VAR{headings.education | tex}}
%% for ed in education
\keepnext{3\baselineskip}
\cventry{\VAR{ed.dates | tex}}{\VAR{ed.degree | tex}}{\VAR{ed.institution | tex}}{}{}{}
%% endfor
%% endif

%% if certificates
\keepnext{8\baselineskip}
\section{\VAR{headings.certificates | tex}}
%% for cert in certificates
\cvitem{\VAR{cert.date | tex}}{\VAR{cert.name | tex}\BLOCK{if cert.issuer}, \VAR{cert.issuer | tex}\BLOCK{endif}}
%% endfor
%% endif

%% if languages
\keepnext{8\baselineskip}
\section{\VAR{headings.languages | tex}}
%% for item in languages
\cvitem{\VAR{item.name | tex}}{\VAR{item.detail | tex}}
%% endfor
%% endif

%% if references is defined and references
\keepnext{3\baselineskip}
\section{References}
\cvitem{}{\VAR{references | tex}}
%% endif

\end{document}
