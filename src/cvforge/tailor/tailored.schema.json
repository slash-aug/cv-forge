{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cv-forge tailored selection",
  "type": "object",
  "properties": {
    "lang": {
      "enum": [
        "en",
        "pt-BR",
        "pt-PT"
      ]
    },
    "angle": {
      "enum": [
        "startup-generalist",
        "payments-fintech",
        "team-lead",
        "product-business"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "company",
        "role"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "text"
      ],
      "additionalProperties": false
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
                },
                "bullets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ref",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "ref",
                "bullets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref",
          "positions"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ref",
          "keywords"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$(?!\n)"
      }
    },
    "letter": {
      "type": "object",
      "properties": {
        "recipient": {
          "type": "string"
        },
        "opening": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "closing": {
          "type": "string"
        }
      },
      "required": [
        "recipient",
        "opening",
        "paragraphs",
        "closing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "lang",
    "angle",
    "target",
    "summary",
    "experience",
    "skills",
    "education",
    "certificates",
    "languages"
  ],
  "additionalProperties": false
}
